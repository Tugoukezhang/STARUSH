    "story": {
      "title": "旧商街的第一排",
      "place": "旧商街 · 开演之前",
      "intro": [
        [
          "旁白",
          "唱片店的节目牌褪成了灰色，门前只剩几张叠好的椅子。三人把器材放在路边。"
        ],
        [
          "步枪手",
          "这块牌以前写过我的名字。先把它擦亮吧。"
        ],
        [
          "重锤手",
          "椅子我来搬，别把第一排也喷了。"
        ],
        [
          "机甲剑士",
          "装卸门那边还能走。器材有路，开演就不难。"
        ]
      ],
      "midpoint": [
        [
          "旁白",
          "橱窗映出了新的颜色。沿着装卸门旁的小路望去，能看见街尾的露天剧场。"
        ],
        [
          "步枪手",
          "原来离剧场这么近。以前我只敢站在店门口。"
        ],
        [
          "机甲剑士",
          "今天往前走一点。我看着后面的路。"
        ],
        [
          "重锤手",
          "音箱接上了，第一排也摆好了。还差你过来。"
        ]
      ],
      "outro": [
        [
          "旁白",
          "干扰退去，剧场前留下了一排亮着的招牌。散落的节目单被收好，背面写着霓虹街口的地址。"
        ],
        [
          "重锤手",
          "真开起来了。明天还搬这些吗？"
        ],
        [
          "步枪手",
          "搬。下一站也许有人在等。"
        ],
        [
          "机甲剑士",
          "先把线收好。路上别再绊到自己。"
        ]
      ]
    },
    "pacing": {
      "id": "opening",
      "objective": "沿街自由涂染，接通设施后前往露天剧场。",
      "pressure": "旧街定线：预告锁定当时的位置，离开弹路后再转回涂染。南区先收设施与串场，实际进入北区后接续中场压力；已有联动仍可提前打断。旧街压轴以定点锁定为主，中段加入横向预判；三段后进入涂染窗口。南北两区各选一条串场线，完成两站；第一站完成后另一线留待复演。旧街同线两站可自由安排先后。",
      "steps": [
        "恢复沿街设施",
        "接通北侧舞台",
        "化解压轴攻击后完成涂染"
      ]
    },
    "briefing": {
      "title": "星光初演 · 旧商街",
      "rule": "攻击会给经过的街面铺上颜色。沿街恢复演出设施，走向露天剧场；靠近装卸门或展板可以互动。",
      "goal": "恢复南街与剧场的十处演出设施，再完成露天压轴。",
      "progression": "点亮第 3、7 盏主灯时，各选择一次本场编排。"
    },
