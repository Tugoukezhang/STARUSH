    "story": {
      "title": "两边都亮着的街口",
      "place": "霓虹街口 · 第二站",
      "intro": [
        [
          "旁白",
          "霓虹街口两侧的店面各自垂着断开的灯线。路中间的招牌仍然没有回应。"
        ],
        [
          "步枪手",
          "先试近的这家。另一边交给谁？"
        ],
        [
          "机甲剑士",
          "我走对面，路口留出来。"
        ],
        [
          "重锤手",
          "我在中间接线。哪边好了，喊一声。"
        ]
      ],
      "midpoint": [
        [
          "旁白",
          "两家店面都恢复了颜色，回应才沿着灯线传到路口。蔚蓝魔法师收起刚才没接通的插头。"
        ],
        [
          "重锤手",
          "难怪刚才不亮。少了哪边都不行。"
        ],
        [
          "机甲剑士",
          "不是谁走得快，是两边都得接上。"
        ],
        [
          "步枪手",
          "好，下次我先问一声，不闷头往前喷了。"
        ]
      ],
      "outro": [
        [
          "旁白",
          "最后一块招牌亮起。街口的人把一张港湾节目单夹进器材箱，约好在终场听完这首曲子。"
        ],
        [
          "步枪手",
          "带上它。别又夹在箱底找不到。"
        ],
        [
          "重锤手",
          "放音箱旁边，肯定忘不了。"
        ],
        [
          "机甲剑士",
          "港湾的风大，明天先检查支架。"
        ]
      ]
    },
    "pacing": {
      "id": "neon",
      "objective": "先接通两侧门灯，再涂染汇流中枢。",
      "pressure": "霓虹截拍：声浪预告按已发生的水平移动估计去向，锁定后不追踪。追击者停步预告后定向突进；横移让路或提前击败均可处理。南区先收设施与串场，实际进入北区后接续中场压力；已有联动仍可提前打断。突进与声浪轮流出招；普通接近和可涂染的干扰仍可能同时发生。支线第二站可能有守卫：靠近会接近出招，离开会回守；可提前击败或绕回涂染，涂满站点后解除回守。街口联动：及时涂满干扰者，可取消未发出的声浪。霓虹压轴交替预判与定点锁定；末段弹路净空且距离足够时折返，预告后不追踪。南北两区各选一条串场线，完成两站；第一站完成后另一线留待复演。霓虹按前站→后站接力。",
      "steps": [
        "接通两侧门灯",
        "恢复汇流中枢",
        "停转修正弹路，完成压轴"
      ]
    },
    "briefing": {
      "title": "霓虹街口 · 试听街巷",
      "rule": "无需逐台配色。先接通试听店与咖啡亭，街口中枢才可涂染；北侧两店接通后，广场双灯开放。房屋和隔板会挡住攻击。",
      "goal": "点亮十盏主灯，再完成压轴演出。",
      "progression": "点亮第 3、7 盏主灯时，各选择一次本场编排。"
    },
